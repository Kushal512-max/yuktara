# YUKTARA Environment Variables — Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub. It is listed in .gitignore.

# PostgreSQL connection string (required)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Examples:
#   Neon:      postgresql://alice:secret@ep-cool-snow-123.us-east-1.aws.neon.tech/yuktara?sslmode=require
#   Supabase:  postgresql://postgres:secret@db.abc.supabase.co:5432/postgres
#   Railway:   postgresql://postgres:secret@containers-us-west-1.railway.app:5432/railway
#   Local:     postgresql://postgres:password@localhost:5432/yuktara
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional: token to protect the /api/init-db endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INIT_TOKEN=your_secure_random_token_here
